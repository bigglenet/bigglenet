{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bigglenet",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bigglenet",
      "database_id": "d68de7d5-a876-46e2-9689-95b8e81e5138",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "Live" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Live"] }],
  // Per-IP limits on sign-up and sign-in, per-user limits on messages and friend requests.
  "ratelimits": [
    { "name": "SIGNUP_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LOGIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "MESSAGE_LIMIT", "namespace_id": "1003", "simple": { "limit": 20, "period": 10 } }
  ],
  // The Biggle browser as a PWA. Everything except /api and /site is the app.
  "assets": {
    "directory": "../browser/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/site/*"]
  },
  "routes": [{ "pattern": "bigglenet.ethembeldagli.dev", "custom_domain": true }],
  "workers_dev": false
}
