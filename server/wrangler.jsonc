{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bigglenet",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Every minute: event reminders and reading sites for search, taking turns (index.ts scheduled).
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bigglenet",
      "database_id": "d68de7d5-a876-46e2-9689-95b8e81e5138",
      "migrations_dir": "migrations"
    },
    // Profile pictures, and pictures, files and voice messages sent in chats (files.ts), apart
    // so they can't fill up the main database.
    {
      "binding": "FILES_DB",
      "database_name": "bigglenet-files",
      "database_id": "15ee71c1-769a-4c51-a2e4-33bb75766a35",
      "migrations_dir": "files-migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "LIVE", "class_name": "Live" },
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Live"] },
    { "tag": "v2", "new_sqlite_classes": ["Room"] }
  ],
  // Per-IP limits on sign-up and sign-in, per-user limits on messages, friend requests and imports.
  "ratelimits": [
    { "name": "SIGNUP_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LOGIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "MESSAGE_LIMIT", "namespace_id": "1003", "simple": { "limit": 20, "period": 10 } },
    { "name": "EMAIL_LIMIT", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
    { "name": "IMPORT_LIMIT", "namespace_id": "1005", "simple": { "limit": 300, "period": 60 } }
  ],
  // Confirming an email: people email their code to JOIN_ADDRESS, which Cloudflare Email Routing
  // passes to this Worker. If the RESEND_API_KEY secret is set, codes are emailed out from
  // MAIL_FROM instead (verify that domain in Resend first).
  "vars": {
    "MAIL_FROM": "noreply@bigglenet.ethembeldagli.dev",
    "JOIN_ADDRESS": "bigglenet@ethembeldagli.dev",
    // The database above, for backups (backups.ts) through the Cloudflare API.
    "D1_DATABASE_ID": "d68de7d5-a876-46e2-9689-95b8e81e5138"
  },
  // The Biggle browser as a PWA. Everything except /api and /site is the app.
  "assets": {
    "directory": "../browser/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/site/*", "/preview/*", "/files/*", "/invite/*", "/passkey/*"]
  },
  "routes": [{ "pattern": "bigglenet.ethembeldagli.dev", "custom_domain": true }],
  "workers_dev": false
}
