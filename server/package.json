{
  "name": "bigglenet-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../browser/dist && wrangler dev --port 8787",
    "deploy": "wrangler d1 migrations apply bigglenet --remote && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply bigglenet --local",
    "db:migrate:remote": "wrangler d1 migrations apply bigglenet --remote",
    "name": "node scripts/admin.mjs name",
    "promote": "node scripts/admin.mjs promote",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "site": "node scripts/admin.mjs site"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0"
  }
}
